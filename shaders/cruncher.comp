#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require

// Galvanity Vulkan cruncher.
//
// Every invocation derives Algorand accounts and checks their address against
// the search pattern. Candidate number idx is fully determined by the host's
// secret ChaCha20 key, so the host can re-derive (and independently verify)
// any reported hit from idx alone:
//
//   seed    = ChaCha20(key, counter = lo32(idx), nonce = hi32(idx) || nonce)[0:32]
//   scalar  = clamp(SHA-512(seed)[0:32])                  (RFC 8032 key expansion)
//   pubkey  = encode(scalar * B)                           (ed25519 public key)
//   address = base32(pubkey || SHA-512/256(pubkey)[28:32])  (58 characters)
//
// Field and group arithmetic is a port of the ref10 ed25519 implementation
// (10 signed limbs, radix 2^25.5, 64-bit products).
//
// Rebuild cruncher.spv after editing: go generate (needs glslc from the Vulkan SDK).

// The workgroup size is set by the host (gpuWorkgroupSize) at pipeline creation.
layout(local_size_x_id = 0) in;

// Precomputed multiples of the base point, see ge_scalarmult_base.
layout(std430, set = 0, binding = 0) readonly buffer BaseTable { ivec4 base_table[]; };

layout(std430, set = 0, binding = 1) readonly buffer Params {
    uint key[8];
    uint nonce[2];
    uint search_type;
    uint pattern_len;
    uint mode;
    uint max_hits;
    uint pattern[58]; // base32 symbol values, 0..31
};

layout(std430, set = 0, binding = 2) buffer Results {
    uint hit_count; // total matches, may exceed max_hits
    uint results_pad;
    uvec2 hits[];   // candidate indices (lo, hi) of the first max_hits matches
};

// MODE_DUMP output: 9 words (36 address bytes) per candidate. Used by tests.
layout(std430, set = 0, binding = 3) writeonly buffer Dump { uint dump[]; };

layout(push_constant) uniform Push {
    uint base_lo;    // index of the first candidate in this dispatch
    uint base_hi;
    uint iterations; // loop iterations per invocation, BATCH candidates each
} pc;

const uint SEARCH_EXACT = 0u;
const uint SEARCH_STARTS = 1u;
const uint SEARCH_ENDS = 2u;
const uint SEARCH_CONTAINS = 3u;

const uint MODE_SEARCH = 0u;
const uint MODE_DUMP = 1u;

const uint ADDRESS_SYMBOLS = 58u;
const uint PUBKEY_SYMBOLS = 51u; // symbols 0..50 do not depend on the checksum

// ---------------------------------------------------------------------------
// GF(2^255 - 19)

void fe_0(out int h[10]) {
    [[unroll]] for (int i = 0; i < 10; i++) h[i] = 0;
}

void fe_1(out int h[10]) {
    fe_0(h);
    h[0] = 1;
}

void fe_add(out int h[10], int f[10], int g[10]) {
    [[unroll]] for (int i = 0; i < 10; i++) h[i] = f[i] + g[i];
}

void fe_sub(out int h[10], int f[10], int g[10]) {
    [[unroll]] for (int i = 0; i < 10; i++) h[i] = f[i] - g[i];
}

void fe_combine(out int h[10], int64_t h0, int64_t h1, int64_t h2, int64_t h3, int64_t h4,
                int64_t h5, int64_t h6, int64_t h7, int64_t h8, int64_t h9) {
    int64_t c;
    c = (h0 + (1L << 25)) >> 26; h1 += c; h0 -= c << 26;
    c = (h4 + (1L << 25)) >> 26; h5 += c; h4 -= c << 26;
    c = (h1 + (1L << 24)) >> 25; h2 += c; h1 -= c << 25;
    c = (h5 + (1L << 24)) >> 25; h6 += c; h5 -= c << 25;
    c = (h2 + (1L << 25)) >> 26; h3 += c; h2 -= c << 26;
    c = (h6 + (1L << 25)) >> 26; h7 += c; h6 -= c << 26;
    c = (h3 + (1L << 24)) >> 25; h4 += c; h3 -= c << 25;
    c = (h7 + (1L << 24)) >> 25; h8 += c; h7 -= c << 25;
    c = (h4 + (1L << 25)) >> 26; h5 += c; h4 -= c << 26;
    c = (h8 + (1L << 25)) >> 26; h9 += c; h8 -= c << 26;
    c = (h9 + (1L << 24)) >> 25; h0 += c * 19L; h9 -= c << 25;
    c = (h0 + (1L << 25)) >> 26; h1 += c; h0 -= c << 26;
    h[0] = int(h0); h[1] = int(h1); h[2] = int(h2); h[3] = int(h3); h[4] = int(h4);
    h[5] = int(h5); h[6] = int(h6); h[7] = int(h7); h[8] = int(h8); h[9] = int(h9);
}

void fe_mul(out int h[10], int f[10], int g[10]) {
    int64_t f0 = int64_t(f[0]), f1 = int64_t(f[1]), f2 = int64_t(f[2]), f3 = int64_t(f[3]), f4 = int64_t(f[4]);
    int64_t f5 = int64_t(f[5]), f6 = int64_t(f[6]), f7 = int64_t(f[7]), f8 = int64_t(f[8]), f9 = int64_t(f[9]);
    int64_t f1_2 = int64_t(2 * f[1]), f3_2 = int64_t(2 * f[3]), f5_2 = int64_t(2 * f[5]);
    int64_t f7_2 = int64_t(2 * f[7]), f9_2 = int64_t(2 * f[9]);
    int64_t g0 = int64_t(g[0]), g1 = int64_t(g[1]), g2 = int64_t(g[2]), g3 = int64_t(g[3]), g4 = int64_t(g[4]);
    int64_t g5 = int64_t(g[5]), g6 = int64_t(g[6]), g7 = int64_t(g[7]), g8 = int64_t(g[8]), g9 = int64_t(g[9]);
    int64_t g1_19 = int64_t(19 * g[1]), g2_19 = int64_t(19 * g[2]), g3_19 = int64_t(19 * g[3]);
    int64_t g4_19 = int64_t(19 * g[4]), g5_19 = int64_t(19 * g[5]), g6_19 = int64_t(19 * g[6]);
    int64_t g7_19 = int64_t(19 * g[7]), g8_19 = int64_t(19 * g[8]), g9_19 = int64_t(19 * g[9]);

    int64_t h0 = f0*g0 + f1_2*g9_19 + f2*g8_19 + f3_2*g7_19 + f4*g6_19 + f5_2*g5_19 + f6*g4_19 + f7_2*g3_19 + f8*g2_19 + f9_2*g1_19;
    int64_t h1 = f0*g1 + f1*g0 + f2*g9_19 + f3*g8_19 + f4*g7_19 + f5*g6_19 + f6*g5_19 + f7*g4_19 + f8*g3_19 + f9*g2_19;
    int64_t h2 = f0*g2 + f1_2*g1 + f2*g0 + f3_2*g9_19 + f4*g8_19 + f5_2*g7_19 + f6*g6_19 + f7_2*g5_19 + f8*g4_19 + f9_2*g3_19;
    int64_t h3 = f0*g3 + f1*g2 + f2*g1 + f3*g0 + f4*g9_19 + f5*g8_19 + f6*g7_19 + f7*g6_19 + f8*g5_19 + f9*g4_19;
    int64_t h4 = f0*g4 + f1_2*g3 + f2*g2 + f3_2*g1 + f4*g0 + f5_2*g9_19 + f6*g8_19 + f7_2*g7_19 + f8*g6_19 + f9_2*g5_19;
    int64_t h5 = f0*g5 + f1*g4 + f2*g3 + f3*g2 + f4*g1 + f5*g0 + f6*g9_19 + f7*g8_19 + f8*g7_19 + f9*g6_19;
    int64_t h6 = f0*g6 + f1_2*g5 + f2*g4 + f3_2*g3 + f4*g2 + f5_2*g1 + f6*g0 + f7_2*g9_19 + f8*g8_19 + f9_2*g7_19;
    int64_t h7 = f0*g7 + f1*g6 + f2*g5 + f3*g4 + f4*g3 + f5*g2 + f6*g1 + f7*g0 + f8*g9_19 + f9*g8_19;
    int64_t h8 = f0*g8 + f1_2*g7 + f2*g6 + f3_2*g5 + f4*g4 + f5_2*g3 + f6*g2 + f7_2*g1 + f8*g0 + f9_2*g9_19;
    int64_t h9 = f0*g9 + f1*g8 + f2*g7 + f3*g6 + f4*g5 + f5*g4 + f6*g3 + f7*g2 + f8*g1 + f9*g0;

    fe_combine(h, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9);
}

// Unreduced f^2 (scaled by 2 when dbl is set), shared by fe_sq and fe_sq2.
void fe_sq_inner(out int h[10], int f[10], bool dbl) {
    int64_t f0 = int64_t(f[0]), f1 = int64_t(f[1]), f2 = int64_t(f[2]), f3 = int64_t(f[3]), f4 = int64_t(f[4]);
    int64_t f5 = int64_t(f[5]), f6 = int64_t(f[6]), f7 = int64_t(f[7]), f8 = int64_t(f[8]), f9 = int64_t(f[9]);
    int64_t f0_2 = int64_t(2 * f[0]), f1_2 = int64_t(2 * f[1]), f2_2 = int64_t(2 * f[2]), f3_2 = int64_t(2 * f[3]);
    int64_t f4_2 = int64_t(2 * f[4]), f5_2 = int64_t(2 * f[5]), f6_2 = int64_t(2 * f[6]), f7_2 = int64_t(2 * f[7]);
    // Premultiplied in 32 bits, as in ref10's C code, so every product below is
    // a 32x32->64 multiply instead of a full 64x64 one. Exact: inputs are
    // fe_combine outputs (|even| <= 2^25, |odd| <= 2^24 + 2^18) or the sum of
    // two (ge_p2_dbl's X+Y), so 19*f[even] and 38*f[odd] stay below 1.22*2^30.
    int64_t f5_38 = int64_t(38 * f[5]), f6_19 = int64_t(19 * f[6]), f7_38 = int64_t(38 * f[7]);
    int64_t f8_19 = int64_t(19 * f[8]), f9_38 = int64_t(38 * f[9]);

    int64_t h0 = f0*f0 + f1_2*f9_38 + f2_2*f8_19 + f3_2*f7_38 + f4_2*f6_19 + f5*f5_38;
    int64_t h1 = f0_2*f1 + f2*f9_38 + f3_2*f8_19 + f4*f7_38 + f5_2*f6_19;
    int64_t h2 = f0_2*f2 + f1_2*f1 + f3_2*f9_38 + f4_2*f8_19 + f5_2*f7_38 + f6*f6_19;
    int64_t h3 = f0_2*f3 + f1_2*f2 + f4*f9_38 + f5_2*f8_19 + f6*f7_38;
    int64_t h4 = f0_2*f4 + f1_2*f3_2 + f2*f2 + f5_2*f9_38 + f6_2*f8_19 + f7*f7_38;
    int64_t h5 = f0_2*f5 + f1_2*f4 + f2_2*f3 + f6*f9_38 + f7_2*f8_19;
    int64_t h6 = f0_2*f6 + f1_2*f5_2 + f2_2*f4 + f3_2*f3 + f7_2*f9_38 + f8*f8_19;
    int64_t h7 = f0_2*f7 + f1_2*f6 + f2_2*f5 + f3_2*f4 + f8*f9_38;
    int64_t h8 = f0_2*f8 + f1_2*f7_2 + f2_2*f6 + f3_2*f5_2 + f4*f4 + f9*f9_38;
    int64_t h9 = f0_2*f9 + f1_2*f8 + f2_2*f7 + f3_2*f6 + f4_2*f5;

    if (dbl) {
        h0 += h0; h1 += h1; h2 += h2; h3 += h3; h4 += h4;
        h5 += h5; h6 += h6; h7 += h7; h8 += h8; h9 += h9;
    }
    fe_combine(h, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9);
}

void fe_sq(out int h[10], int f[10]) { fe_sq_inner(h, f, false); }

void fe_sq2(out int h[10], int f[10]) { fe_sq_inner(h, f, true); }

void fe_invert(out int o[10], int z[10]) {
    int t0[10], t1[10], t2[10], t3[10];
    fe_sq(t0, z);
    fe_sq(t1, t0);
    fe_sq(t1, t1);
    fe_mul(t1, z, t1);
    fe_mul(t0, t0, t1);
    fe_sq(t2, t0);
    fe_mul(t1, t1, t2);
    fe_sq(t2, t1);
    for (int i = 1; i < 5; i++) fe_sq(t2, t2);
    fe_mul(t1, t2, t1);
    fe_sq(t2, t1);
    for (int i = 1; i < 10; i++) fe_sq(t2, t2);
    fe_mul(t2, t2, t1);
    fe_sq(t3, t2);
    for (int i = 1; i < 20; i++) fe_sq(t3, t3);
    fe_mul(t2, t3, t2);
    fe_sq(t2, t2);
    for (int i = 1; i < 10; i++) fe_sq(t2, t2);
    fe_mul(t1, t2, t1);
    fe_sq(t2, t1);
    for (int i = 1; i < 50; i++) fe_sq(t2, t2);
    fe_mul(t2, t2, t1);
    fe_sq(t3, t2);
    for (int i = 1; i < 100; i++) fe_sq(t3, t3);
    fe_mul(t2, t3, t2);
    fe_sq(t2, t2);
    for (int i = 1; i < 50; i++) fe_sq(t2, t2);
    fe_mul(t1, t2, t1);
    fe_sq(t1, t1);
    for (int i = 1; i < 5; i++) fe_sq(t1, t1);
    fe_mul(o, t1, t0);
}

// Canonical little-endian encoding of h as eight 32-bit words (ref10 fe_tobytes).
void fe_pack(out uint w[8], int h[10]) {
    int q = (19 * h[9] + (1 << 24)) >> 25;
    q = (h[0] + q) >> 26;
    q = (h[1] + q) >> 25;
    q = (h[2] + q) >> 26;
    q = (h[3] + q) >> 25;
    q = (h[4] + q) >> 26;
    q = (h[5] + q) >> 25;
    q = (h[6] + q) >> 26;
    q = (h[7] + q) >> 25;
    q = (h[8] + q) >> 26;
    q = (h[9] + q) >> 25;
    h[0] += 19 * q;

    int c;
    c = h[0] >> 26; h[1] += c; h[0] -= c << 26;
    c = h[1] >> 25; h[2] += c; h[1] -= c << 25;
    c = h[2] >> 26; h[3] += c; h[2] -= c << 26;
    c = h[3] >> 25; h[4] += c; h[3] -= c << 25;
    c = h[4] >> 26; h[5] += c; h[4] -= c << 26;
    c = h[5] >> 25; h[6] += c; h[5] -= c << 25;
    c = h[6] >> 26; h[7] += c; h[6] -= c << 26;
    c = h[7] >> 25; h[8] += c; h[7] -= c << 25;
    c = h[8] >> 26; h[9] += c; h[8] -= c << 26;
    c = h[9] >> 25; h[9] -= c << 25;

    // Limb i sits at bit ceil(25.5 * i).
    w[0] = uint(h[0]) | (uint(h[1]) << 26);
    w[1] = (uint(h[1]) >> 6) | (uint(h[2]) << 19);
    w[2] = (uint(h[2]) >> 13) | (uint(h[3]) << 13);
    w[3] = (uint(h[3]) >> 19) | (uint(h[4]) << 6);
    w[4] = uint(h[5]) | (uint(h[6]) << 25);
    w[5] = (uint(h[6]) >> 7) | (uint(h[7]) << 19);
    w[6] = (uint(h[7]) >> 13) | (uint(h[8]) << 12);
    w[7] = (uint(h[8]) >> 20) | (uint(h[9]) << 6);
}

// ---------------------------------------------------------------------------
// Edwards25519 group: -x^2 + y^2 = 1 + d x^2 y^2

struct ge_p2 { int X[10]; int Y[10]; int Z[10]; };              // x = X/Z, y = Y/Z
struct ge_p3 { int X[10]; int Y[10]; int Z[10]; int T[10]; };   // also XY = ZT
struct ge_p1p1 { int X[10]; int Y[10]; int Z[10]; int T[10]; }; // x = X/Z, y = Y/T
struct ge_precomp { int yplusx[10]; int yminusx[10]; int xy2d[10]; };

void ge_p1p1_to_p2(out ge_p2 r, ge_p1p1 p) {
    fe_mul(r.X, p.X, p.T);
    fe_mul(r.Y, p.Y, p.Z);
    fe_mul(r.Z, p.Z, p.T);
}

void ge_p1p1_to_p3(out ge_p3 r, ge_p1p1 p) {
    fe_mul(r.X, p.X, p.T);
    fe_mul(r.Y, p.Y, p.Z);
    fe_mul(r.Z, p.Z, p.T);
    fe_mul(r.T, p.X, p.Y);
}

void ge_p2_dbl(out ge_p1p1 r, ge_p2 p) {
    int t0[10];
    fe_sq(r.X, p.X);
    fe_sq(r.Z, p.Y);
    fe_sq2(r.T, p.Z);
    fe_add(r.Y, p.X, p.Y);
    fe_sq(t0, r.Y);
    fe_add(r.Y, r.Z, r.X);
    fe_sub(r.Z, r.Z, r.X);
    fe_sub(r.X, t0, r.Y);
    fe_sub(r.T, r.T, r.Z);
}

void ge_madd(out ge_p1p1 r, ge_p3 p, ge_precomp q) {
    int t0[10];
    fe_add(r.X, p.Y, p.X);
    fe_sub(r.Y, p.Y, p.X);
    fe_mul(r.Z, r.X, q.yplusx);
    fe_mul(r.Y, r.Y, q.yminusx);
    fe_mul(r.T, q.xy2d, p.T);
    fe_add(t0, p.Z, p.Z);
    fe_sub(r.X, r.Z, r.Y);
    fe_add(r.Y, r.Z, r.Y);
    fe_add(r.Z, t0, r.T);
    fe_sub(r.T, t0, r.T);
}

// Fixed-base scalar multiplication with signed radix-2^W digits.
//
// The clamp clears bits 0..2, so a*B = a'*(8B) with a' = a >> 3 and
// 2^251 <= a' < 2^252. a' is recoded into M = ceil(252/W) signed digits e_k in
// [-HALF, HALF-1] plus a constant top carry c_M (1 iff W divides 252):
//     a' = sum_{k<M} e_k 2^(W k) + c_M 2^(W M)
// The biased digit e_k + HALF is field k (bits W k .. W k + W - 1) of
// y = a' + C, where C = sum_k HALF 2^(W k) has bits W-1, 2W-1, ... set.
//
// T = 1: one pass, digit k uses row k (multiplier 2^(W k) 8B), no doublings.
// T = 2: ref10's trick: odd digits first with row (k-1)/2, then W doublings,
//        then even digits with row k/2; rows have multiplier 2^(2 W i) 8B.
// The first digit of the first pass needs no addition: it indexes the start
// table S[f] = c_M 2^(3 + W (M - T + 1)) B + (f - HALF) 8B, stored as affine
// (x, y, x*y), which also absorbs the constant top carry.
//
// Table layout (baseTable in vulkan.go), 32 ints = 128 bytes per entry:
//   entries [0, 2^W)              start table, indexed by the biased field f
//   entry 2^W + i (HALF+1) + j    row i, j = 0..HALF: j * 2^(T W i) * 8B as
//                                 (y+x, y-x, 2dxy); j = 0 is the identity.

layout(constant_id = 1) const uint W = 8u; // window bits (gpuConfig.window)
layout(constant_id = 2) const uint T = 1u; // interleave (gpuConfig.interleave)

const uint HALF = 1u << (W - 1u);
const uint MASK = (1u << W) - 1u;
const uint M = (252u + W - 1u) / W;   // digits of a >> 3
const uint N_FIRST = M / T;           // digits in the first pass (k = T-1, 2T-1, ...)
const uint N_EVEN = (M + 1u) / 2u;    // digits in the even pass (T == 2 only)
const uint START_ENTRIES = 1u << W;
const uint ROW_ENTRIES = HALF + 1u;
const uint STEP = T * W;              // shift per consumed digit, < 32

// Word j of the bias C. Q has its bits at the positions congruent to 32 mod W;
// C_WORD rotates that pattern to residue W-1-(32j mod W).
const uint Q = 0xffffffffu / MASK;
const uint R32 = 32u % W;
#define C_SHIFT(j) ((W - 1u - ((32u * (j)) % W) + W - R32) % W)
#define C_WORD(j) ((Q << C_SHIFT(j)) | (Q >> (W - C_SHIFT(j))))

// v >>= s for a 256-bit value in two uvec4 (little-endian words), 0 < s < 32.
void shr256(inout uvec4 lo, inout uvec4 hi, uint s) {
    lo = (lo >> s) | (uvec4(lo.yzw, hi.x) << (32u - s));
    hi = (hi >> s) | (uvec4(hi.yzw, 0u) << (32u - s));
}

uint addc(uint x, uint y, inout uint carry) {
    uint c1, c2;
    uint s = uaddCarry(x, y, c1);
    s = uaddCarry(s, carry, c2);
    carry = c1 + c2;
    return s;
}

// Loads table entry e (three field elements) with eight 16-byte loads.
void load_entry(out int f0[10], out int f1[10], out int f2[10], uint e) {
    uint o = 8u * e;
    ivec4 v0 = base_table[o], v1 = base_table[o + 1u], v2 = base_table[o + 2u], v3 = base_table[o + 3u];
    ivec4 v4 = base_table[o + 4u], v5 = base_table[o + 5u], v6 = base_table[o + 6u], v7 = base_table[o + 7u];
    f0 = int[10](v0.x, v0.y, v0.z, v0.w, v1.x, v1.y, v1.z, v1.w, v2.x, v2.y);
    f1 = int[10](v2.z, v2.w, v3.x, v3.y, v3.z, v3.w, v4.x, v4.y, v4.z, v4.w);
    f2 = int[10](v5.x, v5.y, v5.z, v5.w, v6.x, v6.y, v6.z, v6.w, v7.x, v7.y);
}

// t = (f - HALF) * row multiplier, for a biased digit f in [0, 2^W).
void select_point(out ge_precomp t, uint row, uint f) {
    int e = int(f) - int(HALF);
    load_entry(t.yplusx, t.yminusx, t.xy2d, START_ENTRIES + row * ROW_ENTRIES + uint(abs(e)));
    if (e < 0) {
        int tmp[10] = t.yplusx;
        t.yplusx = t.yminusx;
        t.yminusx = tmp;
        [[unroll]] for (int i = 0; i < 10; i++) t.xy2d[i] = -t.xy2d[i];
    }
}

void add_digit(inout ge_p3 h, uint row, uint f) {
    ge_precomp t;
    ge_p1p1 r;
    select_point(t, row, f);
    ge_madd(r, h, t);
    ge_p1p1_to_p3(h, r);
}

// h = a * B for a clamped little-endian scalar a (bits 0..2 clear, bit 254 set, bit 255 clear).
void ge_scalarmult_base(out ge_p3 h, uint a[8]) {
    uvec4 lo = uvec4(a[0], a[1], a[2], a[3]), hi = uvec4(a[4], a[5], a[6], a[7]);
    shr256(lo, hi, 3u);
    uint c = 0u;
    uvec4 ylo, yhi;
    ylo.x = addc(lo.x, C_WORD(0u), c);
    ylo.y = addc(lo.y, C_WORD(1u), c);
    ylo.z = addc(lo.z, C_WORD(2u), c);
    ylo.w = addc(lo.w, C_WORD(3u), c);
    yhi.x = addc(hi.x, C_WORD(4u), c);
    yhi.y = addc(hi.y, C_WORD(5u), c);
    yhi.z = addc(hi.z, C_WORD(6u), c);
    yhi.w = addc(hi.w, C_WORD(7u), c);

    lo = ylo;
    hi = yhi;
    if (T == 2u) shr256(lo, hi, W); // first pass: odd digits

    load_entry(h.X, h.Y, h.T, lo.x & MASK); // start table, affine (x, y, xy)
    fe_1(h.Z);
    shr256(lo, hi, STEP);
    for (uint i = 1u; i < N_FIRST; i++) {
        add_digit(h, i, lo.x & MASK);
        shr256(lo, hi, STEP);
    }

    if (T == 2u) {
        ge_p1p1 r;
        ge_p2 s = ge_p2(h.X, h.Y, h.Z);
        for (uint d = 1u; d < W; d++) {
            ge_p2_dbl(r, s);
            ge_p1p1_to_p2(s, r);
        }
        ge_p2_dbl(r, s);
        ge_p1p1_to_p3(h, r);

        lo = ylo;
        hi = yhi;
        for (uint i = 0u; i < N_EVEN; i++) {
            add_digit(h, i, lo.x & MASK);
            shr256(lo, hi, STEP);
        }
    }
}

