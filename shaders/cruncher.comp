// 64-bit rotate and shift by a constant, built from 32-bit funnel shifts
// (v_alignbit on AMD, SHF on NVIDIA) rather than 64-bit shifts.
uint64_t rotr64(uint64_t x, uint n) {
    uvec2 v = unpack32(x); // (lo, hi)
    if (n >= 32u) {
        v = v.yx;
        n -= 32u;
    }
    if (n == 0u) return pack64(v);
    return pack64(uvec2((v.x >> n) | (v.y << (32u - n)), (v.y >> n) | (v.x << (32u - n))));
}

uint64_t shr64(uint64_t x, uint n) { // 0 < n < 32
    uvec2 v = unpack32(x);
    return pack64(uvec2((v.x >> n) | (v.y << (32u - n)), v.y >> n));
}

uint bswap32(uint x) {
    return (x >> 24) | ((x >> 8) & 0xff00u) | ((x << 8) & 0xff0000u) | (x << 24);
}

// Big-endian 64-bit word from two little-endian 32-bit words (8 message bytes).
uint64_t be64(uint lo, uint hi) {
    return (uint64_t(bswap32(lo)) << 32) | uint64_t(bswap32(hi));
}

// msg is the 32-byte message as little-endian words.
void sha512_32(out uint64_t digest[8], uint msg[8], uint64_t iv[8]) {
    uint64_t w[16];
    [[unroll]] for (int i = 0; i < 4; i++) w[i] = be64(msg[2 * i], msg[2 * i + 1]);
    w[4] = 0x8000000000000000UL;
    [[unroll]] for (int i = 5; i < 15; i++) w[i] = 0UL;
    w[15] = 256UL; // message length in bits

    uint64_t a = iv[0], b = iv[1], c = iv[2], d = iv[3];
    uint64_t e = iv[4], f = iv[5], g = iv[6], h = iv[7];
    [[unroll]] for (int t = 0; t < 80; t++) {
        if (t >= 16) {
            uint64_t s0 = w[(t + 1) & 15];
            uint64_t s1 = w[(t + 14) & 15];
            w[t & 15] += (rotr64(s0, 1u) ^ rotr64(s0, 8u) ^ shr64(s0, 7u)) + w[(t + 9) & 15] +
                         (rotr64(s1, 19u) ^ rotr64(s1, 61u) ^ shr64(s1, 6u));
        }
        uint64_t t1 = h + (rotr64(e, 14u) ^ rotr64(e, 18u) ^ rotr64(e, 41u)) + ((e & f) ^ (~e & g)) + SHA512_K[t] + w[t & 15];
        uint64_t t2 = (rotr64(a, 28u) ^ rotr64(a, 34u) ^ rotr64(a, 39u)) + ((a & b) ^ (a & c) ^ (b & c));
        h = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }
    digest[0] = iv[0] + a; digest[1] = iv[1] + b; digest[2] = iv[2] + c; digest[3] = iv[3] + d;
    digest[4] = iv[4] + e; digest[5] = iv[5] + f; digest[6] = iv[6] + g; digest[7] = iv[7] + h;
}

// ---------------------------------------------------------------------------
// ChaCha20 (RFC 8439 block function), used as the seed generator

uvec4 rotl32(uvec4 v, uint n) { return (v << n) | (v >> (32u - n)); }

void chacha_quarter(inout uvec4 a, inout uvec4 b, inout uvec4 c, inout uvec4 d) {
    a += b; d ^= a; d = rotl32(d, 16u);
    c += d; b ^= c; b = rotl32(b, 12u);
    a += b; d ^= a; d = rotl32(d, 8u);
    c += d; b ^= c; b = rotl32(b, 7u);
}

// First 32 bytes of the keystream block for candidate idx, as little-endian words.
void chacha20_seed(out uint seed[8], uint64_t idx) {
    uvec4 s0 = uvec4(0x61707865u, 0x3320646eu, 0x79622d32u, 0x6b206574u);
    uvec4 s1 = uvec4(key[0], key[1], key[2], key[3]);
    uvec4 s2 = uvec4(key[4], key[5], key[6], key[7]);
    uvec4 s3 = uvec4(uint(idx), uint(idx >> 32), nonce[0], nonce[1]);
    uvec4 a = s0, b = s1, c = s2, d = s3;
    for (int i = 0; i < 10; i++) {
        chacha_quarter(a, b, c, d); // columns
        b = b.yzwx; c = c.zwxy; d = d.wxyz;
        chacha_quarter(a, b, c, d); // diagonals
        b = b.wxyz; c = c.zwxy; d = d.yzwx;
    }
    a += s0;
    b += s1;
    seed[0] = a.x; seed[1] = a.y; seed[2] = a.z; seed[3] = a.w;
    seed[4] = b.x; seed[5] = b.y; seed[6] = b.z; seed[7] = b.w;
}

// ---------------------------------------------------------------------------
// Address derivation and matching

// Candidates per invocation and loop iteration that share one field
// inversion (Montgomery's trick); set by the host (gpuConfig.batch).
layout(constant_id = 3) const int BATCH = 1;

// Seed -> clamped scalar -> scalar * B in projective coordinates.
void derive_point(out ge_p2 r, uint64_t idx) {
    uint seed[8];
    chacha20_seed(seed, idx);

    uint64_t hs[8];
    sha512_32(hs, seed, SHA512_IV);
    uint a[8];
    [[unroll]] for (int i = 0; i < 4; i++) {
        a[2 * i] = bswap32(uint(hs[i] >> 32));
        a[2 * i + 1] = bswap32(uint(hs[i]));
    }
    a[0] &= 0xfffffff8u;
    a[7] = (a[7] & 0x3fffffffu) | 0x40000000u;

    ge_p3 p;
    ge_scalarmult_base(p, a);
    r = ge_p2(p.X, p.Y, p.Z);
}

// The 36 address bytes (public key || checksum) of the affine point (x, y) as
// little-endian words; w[9] is zero so that reading one byte past the end is
// harmless.
void encode_address(out uint w[10], int x[10], int y[10], bool with_checksum) {
    uint xw[8], pk[8];
    fe_pack(xw, x);
    fe_pack(pk, y);
    pk[7] |= (xw[0] & 1u) << 31;

    [[unroll]] for (int i = 0; i < 8; i++) w[i] = pk[i];
    w[8] = 0u;
    w[9] = 0u;
    if (with_checksum) {
        uint64_t hc[8];
        sha512_32(hc, pk, SHA512_256_IV);
        w[8] = bswap32(uint(hc[3])); // digest bytes 28..31
    }
}

// Base32 symbol k (0..57) of the address.
uint symbol_at(uint w[10], uint k) {
    uint bit = k * 5u;
    uint i = bit >> 3;
    uint hi = (w[i >> 2] >> ((i & 3u) * 8u)) & 0xffu;
    uint j = i + 1u;
    uint lo = (w[j >> 2] >> ((j & 3u) * 8u)) & 0xffu;
    return (((hi << 8) | lo) >> (11u - (bit & 7u))) & 31u;
}

bool match_at(uint w[10], uint start) {
    for (uint k = 0u; k < pattern_len; k++) {
        if (symbol_at(w, start + k) != pattern[k]) {
            return false;
        }
    }
    return true;
}

bool matches(uint w[10]) {
    if (search_type == SEARCH_ENDS) {
        return match_at(w, ADDRESS_SYMBOLS - pattern_len);
    }
    if (search_type == SEARCH_CONTAINS) {
        for (uint s = 0u; s + pattern_len <= ADDRESS_SYMBOLS; s++) {
            if (match_at(w, s)) {
                return true;
            }
        }
        return false;
    }
    return match_at(w, 0u); // SEARCH_STARTS, and SEARCH_EXACT with a full-length pattern
}

void report(uint64_t offset, uint64_t idx, uint w[10]) {
    if (mode == MODE_DUMP) {
        uint o = uint(offset) * 9u;
        [[unroll]] for (int i = 0; i < 9; i++) dump[o + uint(i)] = w[i];
    } else if (matches(w)) {
        uint slot = atomicAdd(hit_count, 1u);
        if (slot < max_hits) {
            hits[slot] = uvec2(uint(idx), uint(idx >> 32));
        }
    }
}

void main() {
    uint64_t base = (uint64_t(pc.base_hi) << 32) | uint64_t(pc.base_lo);
    uint64_t stride = uint64_t(gl_NumWorkGroups.x * gl_WorkGroupSize.x);
    uint64_t gid = uint64_t(gl_GlobalInvocationID.x);
    bool with_checksum = mode == MODE_DUMP || search_type != SEARCH_STARTS || pattern_len > PUBKEY_SYMBOLS;

    for (uint it = 0u; it < pc.iterations; it++) {
        // Candidate k of this batch has offset (it*BATCH + k)*stride + gid: the
        // same candidates as BATCH = 1 with BATCH times as many iterations.
        uint64_t first = uint64_t(it) * uint64_t(BATCH) * stride + gid;

        // BATCH scalar multiplications. pend is shifted down after each one so
        // that every index is a compile-time constant and it stays in registers.
        ge_p2 pend[BATCH];
        for (int k = 0; k < BATCH; k++) {
            ge_p2 p;
            derive_point(p, base + first + uint64_t(k) * stride);
            [[unroll]] for (int j = 0; j + 1 < BATCH; j++) pend[j] = pend[j + 1];
            pend[BATCH - 1] = p;
        }

        // One inversion for the batch: acc[k] = Z_0 * ... * Z_k, then walk back.
        // Z is never zero: the twisted Edwards formulas are complete.
        int acc[BATCH][10];
        acc[0] = pend[0].Z;
        [[unroll]] for (int k = 1; k < BATCH; k++) fe_mul(acc[k], acc[k - 1], pend[k].Z);
        int inv[10];
        fe_invert(inv, acc[BATCH - 1]);
        [[unroll]] for (int k = BATCH - 1; k >= 0; k--) {
            int zinv[10];
            if (k > 0) {
                fe_mul(zinv, inv, acc[k - 1]); // 1 / Z_k
                fe_mul(inv, inv, pend[k].Z);   // 1 / (Z_0 ... Z_{k-1})
            } else {
                zinv = inv;
            }
            fe_mul(pend[k].X, pend[k].X, zinv);
            fe_mul(pend[k].Y, pend[k].Y, zinv);
        }

        for (int k = 0; k < BATCH; k++) {
            uint w[10];
            encode_address(w, pend[0].X, pend[0].Y, with_checksum);
            [[unroll]] for (int j = 0; j + 1 < BATCH; j++) pend[j] = pend[j + 1];
            uint64_t offset = first + uint64_t(k) * stride;
            report(offset, base + offset, w);
        }
    }
}
